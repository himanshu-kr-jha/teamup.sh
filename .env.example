# TeamUp Environment Variables
#
# Do not copy this by hand — run ./setup.sh, which writes a .env with a
# generated auth secret and with ports that are actually free on this machine.
# Copying this file verbatim leaves the published placeholder secret in place.

# ── Host ports ────────────────────────────────────────────────────────────
# The ports the backing containers publish on this machine. Only the host side
# moves; inside the Docker network the services always use the standard ports.
# Change one of these and the matching URL further down has to change with it.
TEAMUP_POSTGRES_PORT=5432
TEAMUP_REDIS_PORT=6379
TEAMUP_MINIO_PORT=9000
TEAMUP_MINIO_CONSOLE_PORT=9001
TEAMUP_LIVEKIT_PORT=7880
TEAMUP_LIVEKIT_TCP_PORT=7881

# Moving TEAMUP_LIVEKIT_PORT also needs VITE_LIVEKIT_URL set in web/.env before
# the frontend is built: over plain HTTP the browser dials LiveKit directly and
# otherwise assumes 7880. ./setup.sh writes that file for you.

# Server
TEAMUP_PORT=8080
TEAMUP_ENV=development
TEAMUP_LOG_LEVEL=debug
TEAMUP_BASE_URL=http://localhost:8080

# Database (PostgreSQL)
TEAMUP_DATABASE_URL=postgres://teamup:teamup@localhost:5432/teamup?sslmode=disable

# How many PostgreSQL connections the server holds.
#
# Left unset, pgx sizes the pool at max(4, NumCPU) — four connections on a
# CPU-limited container, shared by every request, every WebSocket handler and
# the push fan-out. 25 covers a 60-person organization's traffic with the
# fan-out running alongside it, and four servers still fit inside PostgreSQL's
# default max_connections of 100 with room for migrations and a psql session.
#
# A `pool_max_conns` written into TEAMUP_DATABASE_URL wins over this.
TEAMUP_DB_MAX_CONNS=25

# Redis
TEAMUP_REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible storage)
TEAMUP_MINIO_ENDPOINT=localhost:9000
TEAMUP_MINIO_ACCESS_KEY=minioadmin
TEAMUP_MINIO_SECRET_KEY=minioadmin
TEAMUP_MINIO_BUCKET=teamup-files
TEAMUP_MINIO_SECURE=false

# The largest file the server accepts, by either upload path. 5 GiB.
TEAMUP_MAX_UPLOAD_BYTES=5368709120
# Where a file stops going up in one PUT and starts going up in resumable
# parts. 16 MiB. This is also the largest single request that ever reaches
# object storage, so it — not the ceiling above — is what nginx's
# client_max_body_size has to cover.
TEAMUP_MULTIPART_THRESHOLD_BYTES=16777216

# LiveKit (Video calls)
TEAMUP_LIVEKIT_URL=http://localhost:7880
TEAMUP_LIVEKIT_API_KEY=devkey
TEAMUP_LIVEKIT_API_SECRET=devsecret

# How many people one call may hold: the size of the LiveKit room, and one more
# than the number of channel members starting a call in a channel will ring.
# Not a media limit — LiveKit seats hundreds — but a bound on fan-out, since
# every invite is a database row and a WebSocket frame.
TEAMUP_MAX_CALL_PARTICIPANTS=200

# Auth
TEAMUP_AUTH_ISSUER=teamup
TEAMUP_AUTH_AUDIENCE=teamup-api
TEAMUP_AUTH_SECRET=your-super-secret-key-change-in-production

# OIDC Providers (optional - can be configured via wizard)
# Google Workspace
TEAMUP_GOOGLE_CLIENT_ID=
TEAMUP_GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID
TEAMUP_ENTRA_CLIENT_ID=
TEAMUP_ENTRA_CLIENT_SECRET=
TEAMUP_ENTRA_TENANT_ID=

# Custom OIDC
TEAMUP_CUSTOM_ISSUER=
TEAMUP_CUSTOM_CLIENT_ID=
TEAMUP_CUSTOM_CLIENT_SECRET=

# SMTP (optional - for email notifications)
TEAMUP_SMTP_HOST=
TEAMUP_SMTP_PORT=587
TEAMUP_SMTP_USER=
TEAMUP_SMTP_PASSWORD=
TEAMUP_SMTP_FROM=

# Auto-setup (for CI/CD)
TEAMUP_AUTO_SETUP=false
TEAMUP_SETUP_ORG_NAME=
TEAMUP_SETUP_ORG_SUBDOMAIN=
TEAMUP_SETUP_ADMIN_EMAIL=
TEAMUP_SETUP_ADMIN_PASSWORD=
TEAMUP_SETUP_OIDC_PROVIDER=
TEAMUP_SETUP_GOOGLE_CLIENT_ID=
TEAMUP_SETUP_GOOGLE_CLIENT_SECRET=
TEAMUP_SETUP_ENTRA_CLIENT_ID=
TEAMUP_SETUP_ENTRA_CLIENT_SECRET=
TEAMUP_SETUP_ENTRA_TENANT_ID=
TEAMUP_SETUP_CUSTOM_ISSUER=
TEAMUP_SETUP_CUSTOM_CLIENT_ID=
TEAMUP_SETUP_CUSTOM_CLIENT_SECRET=
TEAMUP_SETUP_MINIO_ENDPOINT=
TEAMUP_SETUP_MINIO_ACCESS_KEY=
TEAMUP_SETUP_MINIO_SECRET_KEY=
TEAMUP_SETUP_MINIO_BUCKET=
TEAMUP_SETUP_LIVEKIT_URL=
TEAMUP_SETUP_LIVEKIT_API_KEY=
TEAMUP_SETUP_LIVEKIT_API_SECRET=
# ── Reaching TeamUp from another machine ──────────────────────────────────
# A browser will not keep a Secure cookie sent over plain HTTP, so signing in
# from another machine by address fails silently unless this is on. It sends
# the session token in clear, so use it only on a network you trust. Leave it
# alone for anything reachable from the internet.
TEAMUP_INSECURE_COOKIES=false

# Hosts other than this server that may open a WebSocket. Same-origin always
# works and needs no entry here; this is for serving the app separately.
TEAMUP_ALLOWED_WS_ORIGINS=

# LiveKit asks a public STUN server for its address, which on a local network
# is the router's public IP and unreachable from the network itself. To take
# calls from a phone on your own network, set these to this machine's address.
TEAMUP_LIVEKIT_USE_EXTERNAL_IP=true
TEAMUP_LIVEKIT_NODE_IP=
