# The throwaway services the real-stack specs (meetings.spec.ts) and the Go
# integration tests share. Source it:   . web/e2e/test-services.env
#
# They are plain containers named teamup-cal-test-{pg,redis,minio,livekit}. See
# web/e2e/README-services.md for the docker commands that start them, and why the
# LiveKit one must be told where the server under test listens.

# The server under test listens here, and LiveKit's webhook must point at it:
# the container posts to http://host.docker.internal:$E2E_PORT/api/livekit/webhook.
export E2E_PORT="${E2E_PORT:-55470}"

# run.sh (Playwright)
export E2E_PG_HOST=localhost E2E_PG_PORT=55461 E2E_PG_USER=teamup E2E_PG_PASSWORD=teamup
export E2E_DB_NAME="${E2E_DB_NAME:-teamup_meetings_e2e}"
export E2E_REDIS_URL=redis://localhost:55462/9
export E2E_MINIO_ENDPOINT=localhost:55463 E2E_MINIO_BUCKET=teamup-files-test
export E2E_LIVEKIT_URL=http://localhost:55464
# The browser connects here. The frontend takes it at BUILD time (VITE_LIVEKIT_URL), else it uses ws://<host>:7880.
export VITE_LIVEKIT_URL=ws://localhost:55464
export E2E_LIVEKIT_CONTAINER="${E2E_LIVEKIT_CONTAINER:-teamup-cal-test-livekit}"

# go test ./...
export TEAMUP_TEST_DATABASE_URL="postgres://teamup:teamup@localhost:55461/teamup_test?sslmode=disable"
export TEAMUP_TEST_REDIS_URL=redis://localhost:55462
export TEAMUP_TEST_MINIO_ENDPOINT=localhost:55463 TEAMUP_TEST_MINIO_ACCESS_KEY=minioadmin TEAMUP_TEST_MINIO_SECRET_KEY=minioadmin
export TEAMUP_TEST_MINIO_BUCKET=teamup-files-test
export TEAMUP_TEST_LIVEKIT_URL=ws://localhost:55464 TEAMUP_TEST_LIVEKIT_SECRET=devsecret
