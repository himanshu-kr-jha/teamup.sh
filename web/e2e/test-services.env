# The throwaway services the real-stack specs (meetings.spec.ts) and the Go
# integration tests share. Source it:   . web/e2e/test-services.env
#
# They are plain containers named <prefix>-{pg,redis,minio,livekit,mailpit}. See
# web/e2e/README-services.md for the docker commands that start them, and why the
# LiveKit one must be told where the server under test listens.

# Several sets of these services can run side by side, so that test runs from
# different checkouts do not have to wait for each other. Pick one with
# TEAMUP_TEST_SLOT (default 0). Each slot has its own containers, ports,
# databases and lock (scripts/with-test-lock.sh), and nothing else changes.
# Slot 0 is the original set: containers teamup-cal-test-*, ports 55461-55481.
# Slot n (1-9) is teamup-test-s<n>-*, on ports 2n061-2n081 (slot 1: 21061...),
# and its server and fake services move up by n*100 (slot 1: 18570, 18191...).
# Every slot's ports sit below Linux's range for outgoing connections
# (32768-60999) except slot 0's containers, which Docker binds when they start.
TEAMUP_TEST_SLOT="${TEAMUP_TEST_SLOT:-0}"
case "$TEAMUP_TEST_SLOT" in
  [0-9]) ;;
  *) echo "TEAMUP_TEST_SLOT must be 0 to 9, not '$TEAMUP_TEST_SLOT'" >&2; return 1 2>/dev/null || exit 1 ;;
esac
export TEAMUP_TEST_SLOT
if [ "$TEAMUP_TEST_SLOT" = 0 ]; then
  export E2E_SERVICES_PREFIX=teamup-cal-test
  _base=55400
else
  export E2E_SERVICES_PREFIX="teamup-test-s$TEAMUP_TEST_SLOT"
  _base=$((20000 + TEAMUP_TEST_SLOT * 1000))
fi
_shift=$((TEAMUP_TEST_SLOT * 100))
export E2E_PG_SERVICE_PORT=$((_base + 61)) E2E_REDIS_SERVICE_PORT=$((_base + 62))
export E2E_MINIO_SERVICE_PORT=$((_base + 63)) E2E_LIVEKIT_SERVICE_PORT=$((_base + 64))
export E2E_LIVEKIT_TCP_PORT=$((_base + 65)) E2E_LIVEKIT_UDP_PORT=$((_base + 66))
export E2E_MAILPIT_SMTP_PORT=$((_base + 80)) E2E_MAILPIT_API_PORT=$((_base + 81))
export E2E_MAILPIT_API="http://127.0.0.1:$E2E_MAILPIT_API_PORT"
export E2E_GOOGLE_PORT="${E2E_GOOGLE_PORT:-$((18091 + _shift))}" E2E_GITHUB_PORT="${E2E_GITHUB_PORT:-$((18092 + _shift))}"
export E2E_BITBUCKET_PORT="${E2E_BITBUCKET_PORT:-$((18093 + _shift))}" E2E_GEOCODER_PORT="${E2E_GEOCODER_PORT:-$((18094 + _shift))}"
export E2E_MINIO_CONTAINER="$E2E_SERVICES_PREFIX-minio"
unset _base

# The server under test listens here, and LiveKit's webhook must point at it:
# the container posts to http://host.docker.internal:$E2E_PORT/api/livekit/webhook.
export E2E_PORT="${E2E_PORT:-$((18470 + _shift))}"
unset _shift

# run.sh (Playwright)
export E2E_PG_HOST=localhost E2E_PG_PORT=$E2E_PG_SERVICE_PORT E2E_PG_USER=teamup E2E_PG_PASSWORD=teamup
export E2E_DB_NAME="${E2E_DB_NAME:-teamup_meetings_e2e}"
export E2E_REDIS_URL=redis://localhost:$E2E_REDIS_SERVICE_PORT/9
export E2E_MINIO_ENDPOINT=localhost:$E2E_MINIO_SERVICE_PORT E2E_MINIO_BUCKET=teamup-files-test
export E2E_LIVEKIT_URL=http://localhost:$E2E_LIVEKIT_SERVICE_PORT
# The browser connects here. The frontend takes it at BUILD time (VITE_LIVEKIT_URL), else it uses ws://<host>:7880.
export VITE_LIVEKIT_URL=ws://localhost:$E2E_LIVEKIT_SERVICE_PORT
export E2E_LIVEKIT_CONTAINER="$E2E_SERVICES_PREFIX-livekit"

# go test ./...
export TEAMUP_TEST_DATABASE_URL="postgres://teamup:teamup@localhost:$E2E_PG_SERVICE_PORT/teamup_test?sslmode=disable"
export TEAMUP_TEST_REDIS_URL=redis://localhost:$E2E_REDIS_SERVICE_PORT
export TEAMUP_TEST_MINIO_ENDPOINT=localhost:$E2E_MINIO_SERVICE_PORT TEAMUP_TEST_MINIO_ACCESS_KEY=minioadmin TEAMUP_TEST_MINIO_SECRET_KEY=minioadmin
export TEAMUP_TEST_MINIO_BUCKET=teamup-files-test
export TEAMUP_TEST_LIVEKIT_URL=ws://localhost:$E2E_LIVEKIT_SERVICE_PORT TEAMUP_TEST_LIVEKIT_SECRET=devsecret
