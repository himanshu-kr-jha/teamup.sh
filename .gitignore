# Binaries
bin/
/teamup
*.exe
*.dll
*.so
*.dylib

# Test binary
*.test

# Output of go coverage tool
*.out
coverage.out

# Dependency directories
vendor/

# IDE / agent tooling
.idea/
.vscode/
.serena/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local
# setup.sh --force keeps the previous .env aside before replacing it.
.env.backup.*
.env.bak.*

# .env.example is documentation and must ship. This negation is here because a
# common global gitignore rule (`.env.*`) otherwise swallows it — which it did:
# the file existed locally for months while every clone of this repository got
# no .env.example at all, so setup.sh had nothing to copy from.
!.env.example

# Logs
*.log
logs/

# Build artifacts
dist/
build/
web/dist/
web/dev-dist/
cmd/teamup/web/dist/

# Database
*.db
*.sqlite
*.sqlite3

# Certificates
certs/
*.pem
*.key
*.crt

# MinIO data
minio-data/

# Docker
.docker/

# Terraform
*.tfstate
*.tfstate.*
.tfplan

# Helm
helm/teamup/charts/
helm/teamup/*.tgz

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite
web/.vite/
web/coverage/

# Playwright
web/test-results/
web/playwright-report/
web/e2e-shots/

# Turbo
.turbo/

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Agent worktrees are git-managed checkouts, not repository content.
.claude/worktrees/

# Database dumps and object storage archives, from docs/DEPLOYMENT.md.
backups/

# Where scripts/deploy.sh deploys to. Server addresses stay out of the repository.
.deploy.env
.deploy.*.env
