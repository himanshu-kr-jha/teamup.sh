# Copy to .deploy.env (never committed) and fill in, then: make deploy
# See docs/BUILD-AND-DEPLOY.md.

# Who to ssh in as, and where.
TEAMUP_DEPLOY_HOST=ubuntu@teamup.example.com
# The ssh key, if it is not your default one.
#TEAMUP_DEPLOY_KEY=~/.ssh/teamup-vm.pem
# Where TeamUp lives on the server.
#TEAMUP_DEPLOY_DIR=/opt/teamup
# ssh over IPv4 only, if your network's IPv6 route to the server is unreliable.
#TEAMUP_DEPLOY_IPV4=1
